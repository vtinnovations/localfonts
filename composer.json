{
    "name": "vtinnovations/localfonts",
    "type": "contao-bundle",
    "description": "Local Fonts — crawls the site for Google Fonts, downloads them locally and injects a local stylesheet (GDPR-friendly).",
    "keywords": ["contao", "fonts", "google-fonts", "gdpr", "dsgvo", "performance"],
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "V&T Innovations Team",
            "homepage": "https://www.v-t.one"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "contao/core-bundle": "^5.3",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "VTinnovations\\LocalFonts\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "VTinnovations\\LocalFonts\\ContaoManager\\Plugin"
    }
}
